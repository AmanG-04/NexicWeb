{
  "name": "nexicweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexicweb-leads",
      "database_id": "c4f3ed46-4c9e-434b-a2f2-1073073dca85",
      "migrations_dir": "migrations"
    }
  ]
}
